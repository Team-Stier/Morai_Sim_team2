<?xml version="1.0"?>
<launch>
  <!-- Synthetic sensor inputs are confined to rostest's new master. -->
  <param name="/use_sim_time" value="true"/>
  <node pkg="localization_pkg" type="localization_estimator_node.py"
        name="localization_node" output="screen">
    <rosparam command="load" file="$(find localization_pkg)/config/localization.yaml"/>
  </node>
  <test pkg="localization_pkg" type="test_localization_estimator.py"
        name="localization_estimator_test" test-name="localization_estimator"
        time-limit="90"/>
</launch>
