<?xml version="1.0"?>
<launch>
  <param name="/use_sim_time" value="true" />

  <node pkg="localization_pkg" type="localization_node" name="localization_node" output="screen">
    <rosparam command="load" file="$(find localization_pkg)/config/localization.yaml"/>
    <param name="status_publish_rate_hz" value="10.0"/>
    <!-- Test-only watchdog candidate; not an approved production freshness bound. -->
    <param name="clock_stall_sec" value="0.4"/>
  </node>

  <!-- rostest creates a separate master; never run this with its reuse-master option. -->
  <test pkg="localization_pkg" type="test_localization_node.py" name="localization_node_diagnostic" test-name="localization_node_diagnostic" time-limit="90"/>
</launch>
