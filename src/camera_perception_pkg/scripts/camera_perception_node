#!/usr/bin/env python3
"""Front PIDNet and optional Camera3 YOLO; each keeps only its newest frame."""
import json
import threading
import cv2
import numpy as np
import rospy
from sensor_msgs.msg import CompressedImage, Image
from std_msgs.msg import String


class CameraNode:
    def __init__(self):
        from cv_bridge import CvBridge
        from camera_perception_pkg.semantic import Segmenter
        self.segmenter = Segmenter(rospy.get_param('~weights'), rospy.get_param('~device'))
        self.bridge = CvBridge()
        self.pending = None
        self.lock = threading.Lock()
        self.publisher = rospy.Publisher('/molit/perception/camera/front/semantic_scores', Image, queue_size=1)
        self.subscriber = rospy.Subscriber('/molit/sensors/camera/front/image/compressed', CompressedImage,
                                          self.receive, queue_size=1, buff_size=4 * 1024 * 1024)
        threading.Thread(target=self.process, daemon=True).start()

    def receive(self, message):
        with self.lock:
            self.pending = message

    def process(self):
        while not rospy.is_shutdown():
            with self.lock:
                message, self.pending = self.pending, None
            if message is None:
                rospy.rostime.wallsleep(0.005)
                continue
            try:
                bgr = cv2.imdecode(np.frombuffer(message.data, np.uint8), cv2.IMREAD_COLOR)
                if bgr is None or message.header.stamp.is_zero():
                    continue
                scores = self.segmenter(cv2.cvtColor(bgr, cv2.COLOR_BGR2RGB))
                output = self.bridge.cv2_to_imgmsg(scores, encoding='passthrough')
                output.header = message.header
                self.publisher.publish(output)
            except (ValueError, RuntimeError, cv2.error) as error:
                rospy.logwarn_throttle(2, 'PIDNet frame rejected: %s', error)


class SignalNode:
    def __init__(self):
        from camera_perception_pkg.signal_detector import SignalDetector
        self.detector = SignalDetector(rospy.get_param('~signal_weights'),
                                       rospy.get_param('~signal_device'),
                                       rospy.get_param('~signal_imgsz'),
                                       rospy.get_param('~signal_confidence'))
        self.pending = None
        self.condition = threading.Condition()
        self.image_pub = rospy.Publisher('~signal_image', Image, queue_size=1)
        self.detections_pub = rospy.Publisher('~signal_detections', String, queue_size=1)
        self.subscriber = rospy.Subscriber('/molit/sensors/camera/signal/image/compressed',
                                          CompressedImage, self.receive, queue_size=1,
                                          buff_size=8 * 1024 * 1024)
        threading.Thread(target=self.process, daemon=True).start()
        rospy.loginfo('Camera3 YOLO ready; diagnostic housing candidates only')

    def receive(self, message):
        with self.condition:
            self.pending = message
            self.condition.notify()

    def process(self):
        while not rospy.is_shutdown():
            with self.condition:
                if self.pending is None:
                    self.condition.wait(timeout=.1)
                    continue
                message, self.pending = self.pending, None
            try:
                if message.header.stamp.is_zero():
                    continue
                bgr = cv2.imdecode(np.frombuffer(message.data, np.uint8), cv2.IMREAD_COLOR)
                if bgr is None:
                    continue
                annotated, candidates = self.detector(bgr)
                output = Image(header=message.header, height=annotated.shape[0],
                               width=annotated.shape[1], encoding='bgr8',
                               is_bigendian=0, step=annotated.shape[1] * 3,
                               data=annotated.tobytes())
                self.image_pub.publish(output)
                self.detections_pub.publish(String(data=json.dumps(dict(
                    stamp=dict(secs=message.header.stamp.secs,
                               nsecs=message.header.stamp.nsecs),
                    frame_id=message.header.frame_id, candidates=candidates,
                    route_target_selected=False, driving_decision_valid=False))))
                rospy.loginfo_throttle(5, 'Camera3 YOLO: %d housing candidates', len(candidates))
            except (ValueError, RuntimeError, cv2.error) as error:
                rospy.logwarn_throttle(2, 'Camera3 YOLO frame rejected: %s', error)


if __name__ == '__main__':
    rospy.init_node('camera_perception_node')
    nodes = []
    if rospy.get_param('~enable_semantic', True):
        nodes.append(CameraNode())
    if rospy.get_param('~enable_signal', False):
        nodes.append(SignalNode())
    rospy.spin()
