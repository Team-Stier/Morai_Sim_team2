<?xml version="1.0"?>
<launch>
  <arg name="weights" default=""/>
  <arg name="python" default="python3"/>
  <arg name="enable_semantic" default="true"/>
  <arg name="enable_signal" default="false"/>
  <arg name="signal_weights" default=""/>
  <node pkg="camera_perception_pkg" type="camera_perception_node" name="camera_perception_node"
        ns="/" output="screen" launch-prefix="$(arg python)">
    <rosparam command="load" file="$(find camera_perception_pkg)/config/pointpainting.yaml"/>
    <rosparam command="load" file="$(find camera_perception_pkg)/config/signal_yolo.yaml"/>
    <param name="weights" value="$(arg weights)"/>
    <param name="enable_semantic" value="$(arg enable_semantic)"/>
    <param name="enable_signal" value="$(arg enable_signal)"/>
    <param name="signal_weights" value="$(arg signal_weights)"/>
  </node>
</launch>
