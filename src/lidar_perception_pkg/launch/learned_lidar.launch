<?xml version="1.0"?>
<launch>
  <!-- Alternative standalone backend. Stop the DBSCAN node before using this. -->
  <arg name="python" default="$(env HOME)/.local/share/morai-lidar-model-env/bin/python"/>
  <arg name="model_repository" default="$(env HOME)/.local/share/morai-OpenPCDet"/>
  <arg name="checkpoint" default="$(arg model_repository)/pp_multihead_nds5823_updated.pth"/>
  <!-- Empty uses config/learned.yaml; optional override for diagnostics. -->
  <arg name="score_threshold" default=""/>
  <node pkg="lidar_perception_pkg" type="learned_lidar_node.py" name="lidar_perception_node"
        ns="/" output="screen" launch-prefix="$(arg python)">
    <rosparam command="load" file="$(find lidar_perception_pkg)/config/detector.yaml"/>
    <rosparam command="load" file="$(find lidar_perception_pkg)/config/learned.yaml"/>
    <rosparam command="load" ns="contract" file="$(find ros_architecture_pkg)/config/messages/lidar_runtime.yaml"/>
    <param name="model_repository" value="$(arg model_repository)"/>
    <param name="checkpoint" value="$(arg checkpoint)"/>
    <param if="$(eval arg('score_threshold') != '')" name="score_threshold" type="double" value="$(arg score_threshold)"/>
  </node>
</launch>
