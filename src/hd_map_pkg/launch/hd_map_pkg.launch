<?xml version="1.0"?>
<launch>
  <arg name="source" default="$(find hd_map_pkg)/vendor/verdict_sdk/map-data/KATRI"/>
  <arg name="path_file" default="$(find hd_map_pkg)/../../참고파일들/2026_molit_comp_global_path (3).txt"/>
  <arg name="checkpoints_file" default="$(find ros_architecture_pkg)/config/map/checkpoints.yaml"/>
  <arg name="speed_policy_file" default="$(find ros_architecture_pkg)/config/map/course_speed_policy.yaml"/>
  <node pkg="hd_map_pkg" type="hd_map_server_node" name="hd_map_server_node" output="screen">
    <param name="config_file" value="$(find hd_map_pkg)/config/map_conversion.yaml"/>
    <param name="source" value="$(arg source)"/>
    <param name="path_file" value="$(arg path_file)"/>
    <param name="checkpoints_file" value="$(arg checkpoints_file)"/>
    <param name="speed_policy_file" value="$(arg speed_policy_file)"/>
  </node>
</launch>
