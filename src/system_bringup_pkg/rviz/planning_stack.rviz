Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /HD Map1
        - /Global Path1
        - /Local Path1
        - /Team1 Controller Path1
        - /Team1 Lookahead1
        - /Team1 Stanley Projection1
        - /Ego Trace1
      Splitter Ratio: 0.5
    Tree Height: 650
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.25
      Cell Size: 10
      Class: rviz/Grid
      Color: 90; 90; 90
      Enabled: false
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 28
      Plane: XY
      Plane Cell Count: 100
      Reference Frame: <Fixed Frame>
      Value: false
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /hd_map/markers
      Name: HD Map
      Namespaces: {}
      Queue Size: 1
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 255; 210; 0
      Enabled: true
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Billboards
      Line Width: 0.16
      Name: Global Path
      Offset:
        X: 0
        Y: 0
        Z: 0.08
      Pose Color: 255; 210; 0
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic: /planning/global_path
      Unreliable: false
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 0; 255; 255
      Enabled: true
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Billboards
      Line Width: 0.24
      Name: Local Path
      Offset:
        X: 0
        Y: 0
        Z: 0.16
      Pose Color: 0; 255; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic: /planning/local_path
      Unreliable: false
      Value: true
    - Alpha: 0.9
      Buffer Length: 1
      Class: rviz/Path
      Color: 255; 80; 220
      Enabled: true
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Billboards
      Line Width: 0.14
      Name: Team1 Controller Path
      Offset:
        X: 0
        Y: 0
        Z: 0.20
      Pose Color: 255; 80; 220
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic: /control_test/team1/local_path
      Unreliable: false
      Value: true
    - Alpha: 1
      Class: rviz/PointStamped
      Color: 80; 255; 80
      Enabled: true
      History Length: 1
      Name: Team1 Lookahead
      Radius: 0.30
      Topic: /control_test/team1/lookahead_point
      Unreliable: false
      Value: true
    - Alpha: 1
      Class: rviz/PointStamped
      Color: 255; 80; 80
      Enabled: true
      History Length: 1
      Name: Team1 Stanley Projection
      Radius: 0.25
      Topic: /control_test/team1/stanley_projection_point
      Unreliable: false
      Value: true
    - Alpha: 0.9
      Buffer Length: 1
      Class: rviz/Path
      Color: 255; 120; 20
      Enabled: true
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Billboards
      Line Width: 0.10
      Name: Ego Trace
      Offset:
        X: 0
        Y: 0
        Z: 0.22
      Pose Color: 255; 120; 20
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic: /planning/ego_trace
      Unreliable: false
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /planning/vehicle_marker
      Name: Ego Vehicle
      Namespaces: {}
      Queue Size: 1
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /planning/corridor_markers
      Name: Active Corridor
      Namespaces: {}
      Queue Size: 1
      Value: true
  Enabled: true
  Global Options:
    Background Color: 24; 24; 28
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
      Line color: 128; 128; 0
  Value: true
  Views:
    Current:
      Angle: -1.5707963267948966
      Class: rviz/TopDownOrtho
      Name: KATRI Top Down
      Near Clip Distance: 0.01
      Scale: 1.0
      Target Frame: map
      Value: TopDownOrtho (rviz)
      X: -30
      Y: -100
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1440
  X: 40
  Y: 40
