<launch>
  <arg name="pidnet_enabled" default="true"/>
  <arg name="pidnet_weights" default="/home/paik/morai-artifacts/pidnet-training/output/Morai6/pidnet_s_morai6/best.pt"/>
  <arg name="pidnet_python" default="/home/paik/venvs/morai-pidnet/bin/python"/>
  <!-- User's complete development driving stack; reuse package-owned launch files. -->
  <arg name="rviz" default="true"/>
  <arg name="send_to_morai" default="true"/>
  <arg name="test_speed_cap_kph" default="0.0"/>
  <arg name="camera3_yolo" default="true"/>
  <arg name="signal_python" default="$(env HOME)/venvs/morai-yolo/bin/python"/>
  <arg name="signal_weights" default="$(find camera_perception_pkg)/../../weights/camera3_route_signal.pt"/>
  <include if="$(arg camera3_yolo)" file="$(find system_bringup_pkg)/launch/camera3_signal.launch">
    <arg name="python" value="$(arg signal_python)"/>
    <arg name="weights" value="$(arg signal_weights)"/>
  </include>
  <include file="$(find morai_interface_pkg)/launch/morai_interface_pkg.launch">
    <arg name="start_imu" value="true"/>
    <arg name="start_lidar" value="true"/>
    <arg name="start_lidar_watchdog" value="true"/>
  </include>
  <include file="$(find system_bringup_pkg)/launch/localization_visualization.launch">
    <arg name="pidnet_enabled" value="$(arg pidnet_enabled)"/>
    <arg name="rviz" value="$(arg rviz)"/>
  </include>
  <include file="$(find system_bringup_pkg)/launch/frenet_rddf.launch">
    <arg name="pidnet_enabled" value="$(arg pidnet_enabled)"/>
    <arg name="pidnet_weights" value="$(arg pidnet_weights)"/>
    <arg name="pidnet_python" value="$(arg pidnet_python)"/>
    <arg name="send_to_morai" value="$(arg send_to_morai)"/>
    <arg name="test_speed_cap_kph" value="$(arg test_speed_cap_kph)"/>
  </include>
</launch>
