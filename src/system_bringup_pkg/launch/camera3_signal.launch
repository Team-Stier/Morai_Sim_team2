<launch>
  <arg name="python" default="$(env HOME)/venvs/morai-yolo/bin/python"/>
  <arg name="weights" default="$(find camera_perception_pkg)/../../weights/camera3_route_signal.pt"/>
  <arg name="start_perception" default="true"/>
  <arg name="start_receiver" default="true"/>
  <node if="$(arg start_receiver)" pkg="morai_interface_pkg" type="camera_receiver_node"
        name="morai_camera_signal" ns="/" output="screen" required="true">
    <rosparam command="load" file="$(find morai_interface_pkg)/config/camera_signal.yaml"/>
  </node>
  <include if="$(arg start_perception)" file="$(find camera_perception_pkg)/launch/camera_perception_pkg.launch">
    <arg name="enable_semantic" value="false"/>
    <arg name="enable_signal" value="true"/>
    <arg name="signal_weights" value="$(arg weights)"/>
    <arg name="python" value="$(arg python)"/>
  </include>
</launch>
