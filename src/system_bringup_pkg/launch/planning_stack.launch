<?xml version="1.0"?>
<launch>
  <arg name="use_rviz" default="true" />
  <arg name="rviz_config"
       default="$(find system_bringup_pkg)/rviz/planning_stack.rviz" />
  <arg name="map_source_directory"
       default="$(find hd_map_pkg)/vendor/verdict_sdk/map-data/KATRI" />
  <arg name="map_config_file"
       default="$(find hd_map_pkg)/config/map_conversion.yaml" />
  <arg name="route_file" default="reference_file_from_hd_map_config" />
  <arg name="route_config_file"
       default="$(find global_route_manager_pkg)/config/competition_route.yaml" />
  <arg name="planner_config_file"
       default="$(find path_planning_pkg)/config/hybrid_astar.yaml" />

  <!-- These component launches own their parameters and public ROS interfaces. -->
  <include if="$(arg use_rviz)"
           file="$(find hd_map_pkg)/launch/hd_map_pkg.launch">
    <arg name="map_source_directory" value="$(arg map_source_directory)" />
    <arg name="map_config_file" value="$(arg map_config_file)" />
  </include>
  <include file="$(find global_route_manager_pkg)/launch/global_route_manager_pkg.launch">
    <arg name="route_file" value="$(arg route_file)" />
    <arg name="route_config_file" value="$(arg route_config_file)" />
  </include>
  <include file="$(find path_planning_pkg)/launch/path_planning_pkg.launch">
    <arg name="planner_config_file" value="$(arg planner_config_file)" />
    <arg name="map_source_directory" value="$(arg map_source_directory)" />
    <arg name="map_config_file" value="$(arg map_config_file)" />
  </include>
  <include file="$(find runtime_evaluation_pkg)/launch/runtime_evaluation_pkg.launch" />

  <!-- No simulator, localization, world-model, or fake-data publisher is started here. -->
  <node if="$(arg use_rviz)"
        pkg="rviz"
        type="rviz"
        name="rviz"
        ns="planning"
        args="-d $(arg rviz_config)"
        output="screen"
        required="false" />
</launch>
