<launch>
  <!-- Alternative to vehicle_visualizer_node's LiDAR markers; read-only debugging. -->
  <arg name="rviz" default="true"/>
  <node pkg="visualization_pkg" type="lidar_debug_display.py" name="lidar_debug_display"
        ns="/molit/internal/visualization" output="screen">
    <rosparam command="load" file="$(find visualization_pkg)/config/lidar_debug.yaml"/>
  </node>
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="vehicle_rviz"
        ns="/" args="-d $(find visualization_pkg)/config/lidar_debug.rviz"/>
</launch>
