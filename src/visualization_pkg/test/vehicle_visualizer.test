<?xml version="1.0"?>
<launch>
  <!-- rostest starts an isolated master. Never reuse a running master here. -->
  <param name="/use_sim_time" value="true"/>
  <node pkg="visualization_pkg" type="vehicle_visualizer_node.py"
        name="vehicle_visualizer_node" output="screen">
    <param name="reference_frame" value="map"/>
    <param name="display_mode" value="box"/>
    <param name="vehicle_length_m" value="4.635"/>
    <param name="vehicle_width_m" value="1.892"/>
    <param name="vehicle_height_m" value="2.434"/>
    <!-- Explicit test geometry, independent of the provisional simulator pivot. -->
    <rosparam param="body_center_offset_m">[1.0, 0.0, 0.5]</rosparam>
    <param name="body_center_offset_verified" value="false"/>
    <param name="display_timeout_sec" value="0.8"/>
    <param name="clock_stall_sec" value="2.0"/>
    <param name="buffer_size" value="20"/>
    <param name="marker_publish_rate_hz" value="20.0"/>
  </node>
  <test pkg="visualization_pkg" type="test_vehicle_visualizer.py"
        name="vehicle_visualizer_test" test-name="vehicle_visualizer"
        time-limit="90"/>
</launch>
