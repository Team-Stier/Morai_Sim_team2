Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Vehicle1
      Splitter Ratio: 0.55
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Metre Grid
      Enabled: true
      Value: true
      Alpha: 0.28
      Cell Size: 1
      Color: 114; 137; 159
      Line Style:
        Line Width: 0.02
        Value: Lines
      Normal Cell Count: 0
      Offset: {X: 0, Y: 0, Z: -0.05}
      Plane: XY
      Plane Cell Count: 100
      Reference Frame: <Fixed Frame>
    - Class: rviz/MarkerArray
      Name: Vehicle
      Enabled: true
      Value: true
      Marker Topic: /molit/internal/visualization/vehicle_markers
      Queue Size: 10
      Namespaces: {}
    - Class: rviz/MarkerArray
      Name: LiDAR detections (development)
      Enabled: true
      Value: true
      Marker Topic: /molit/internal/visualization/lidar_markers
      Queue Size: 2
      Namespaces: {}
    - Class: rviz/MarkerArray
      Name: HD Map
      Enabled: true
      Value: true
      Marker Topic: /molit/internal/visualization/hd_map_markers
      Queue Size: 1
      Namespaces: {}
  Enabled: true
  Global Options:
    Background Color: 19; 27; 38
    Fixed Frame: map
    Frame Rate: 60
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Angle: 0
      Name: Current View
      Near Clip Distance: 0.01
      Scale: 10
      Target Frame: base_link
      Value: TopDownOrtho (rviz)
      X: 1.5
      Y: 0
    Saved: ~
Window Geometry:
  Width: 1280
  Height: 800
  X: 40
  Y: 60
  Hide Left Dock: false
  Hide Right Dock: true
