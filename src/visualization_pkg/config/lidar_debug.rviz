Panels:
- Class: rviz/Displays
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    - /Vehicle1
    Splitter Ratio: 0.55
- Class: rviz/Views
  Name: Views
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz/Grid
    Name: Metre Grid
    Enabled: true
    Value: true
    Alpha: 0.28
    Cell Size: 1
    Color: 114; 137; 159
    Line Style:
      Line Width: 0.02
      Value: Lines
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: -0.05
    Plane: XY
    Plane Cell Count: 40
    Reference Frame: <Fixed Frame>
  - Class: rviz/PointCloud2
    Name: Raw LiDAR - gray
    Enabled: true
    Value: true
    Topic: /molit/sensors/lidar/points
    Queue Size: 2
    Style: Points
    Size (Pixels): 2
    Size (m): 0.025
    Alpha: 0.6
    Color Transformer: FlatColor
    Color: 170; 180; 195
    Position Transformer: XYZ
    Decay Time: 0
    Use Fixed Frame: true
  - Class: rviz/PointCloud2
    Name: ROI points - cyan
    Enabled: true
    Value: true
    Topic: /lidar_perception_node/filtered_points
    Queue Size: 2
    Style: Points
    Size (Pixels): 3
    Size (m): 0.06
    Alpha: 1.0
    Color Transformer: FlatColor
    Color: 0; 255; 210
    Position Transformer: XYZ
    Decay Time: 0
    Use Fixed Frame: true
  - Class: rviz/MarkerArray
    Name: Detections - class colors
    Enabled: true
    Value: true
    Marker Topic: /molit/internal/visualization/lidar_markers
    Queue Size: 2
    Namespaces: {}
  Enabled: true
  Global Options:
    Background Color: 19; 27; 38
    Fixed Frame: lidar_link
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz/Interact
    Hide Inactive Objects: true
  - Class: rviz/MoveCamera
  - Class: rviz/Select
  - Class: rviz/FocusCamera
  - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 22
      Focal Point:
        X: 4
        Y: 0
        Z: 0
      Pitch: 0.8
      Yaw: 3.14
      Target Frame: lidar_link
      Name: Current View
      Near Clip Distance: 0.01
      Value: Orbit (rviz)
    Saved: null
Window Geometry:
  Width: 1440
  Height: 900
  X: 40
  Y: 40
  Hide Left Dock: false
  Hide Right Dock: true
