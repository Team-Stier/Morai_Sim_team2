#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
fake_ctrl_cmd_publisher
- 역할: 테스트용으로 /control/final_command(morai_msgs/CtrlCmd)를 주기 발행한다.
        Controller가 아직 없을 때 Ctrl Cmd Bridge를 검증하기 위한 가짜 퍼블리셔.
- morai_msgs가 빌드되어 있어야 한다.

사용 예:
    rosrun morai_interface_pkg fake_ctrl_cmd_publisher _rate:=30 _accel:=0.3 _steering:=0.1
"""

import rospy
from morai_msgs.msg import CtrlCmd


def main():
    rospy.init_node("fake_ctrl_cmd_publisher")
    topic = rospy.get_param("~topic", "/control/final_command")
    rate_hz = float(rospy.get_param("~rate", 30.0))
    long_cmd_type = int(rospy.get_param("~longlCmdType", 1))
    accel = float(rospy.get_param("~accel", 0.3))
    brake = float(rospy.get_param("~brake", 0.0))
    steering = float(rospy.get_param("~steering", 0.1))
    velocity = float(rospy.get_param("~velocity", 0.0))
    acceleration = float(rospy.get_param("~acceleration", 0.0))

    publisher = rospy.Publisher(topic, CtrlCmd, queue_size=10)
    rate = rospy.Rate(rate_hz)
    rospy.loginfo("[fake_ctrl_cmd_publisher] '%s' @ %.1fHz "
                  "(longlCmdType=%d accel=%.2f brake=%.2f steering=%.2f)",
                  topic, rate_hz, long_cmd_type, accel, brake, steering)
    while not rospy.is_shutdown():
        message = CtrlCmd()
        message.longlCmdType = long_cmd_type
        message.accel = accel
        message.brake = brake
        message.steering = steering
        message.velocity = velocity
        message.acceleration = acceleration
        publisher.publish(message)
        rate.sleep()


if __name__ == "__main__":
    try:
        main()
    except rospy.ROSInterruptException:
        pass


