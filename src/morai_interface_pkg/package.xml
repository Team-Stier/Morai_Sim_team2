<?xml version="1.0"?>
<package format="2">
  <name>morai_interface_pkg</name>
  <version>0.1.0</version>
  <description>MORAI competition UDP sensor input to normalized ROS message bridge.</description>
  <maintainer email="simonpaik04@gmail.com">Team Stier</maintainer>
  <license>TODO</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>common_msgs_pkg</depend>
  <depend>geometry_msgs</depend>
  <depend>ros_architecture_pkg</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
