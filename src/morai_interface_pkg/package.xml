<?xml version="1.0"?>
<package format="2">
  <name>morai_interface_pkg</name>
  <version>0.1.0</version>
  <description>
    MORAI SIM UDP와 ROS 메시지를 잇는 브리지. 수신: GPS(NMEA->NavSatFix),
    IMU(->Imu), EgoVehicleStatus(->TwistWithCovarianceStamped),
    Camera(MOR 청크->CompressedImage), LiDAR(VLP16, velodyne 패키지 연동).
    송신: Ego Ctrl Cmd(CtrlCmd->EgoCtrlCmd UDP). CollisionData/Competition은 미구현.
  </description>

  <maintainer email="jackmarriott770@gmail.com">Team Stier</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <!-- Ego Ctrl Cmd 송신 브리지가 구독하는 morai_msgs/CtrlCmd -->
  <depend>morai_msgs</depend>

  <!-- LiDAR(VLP16)은 자체 파서 없이 표준 velodyne 패키지를 launch에서 사용한다.
       설치: sudo apt install ros-noetic-velodyne -->
  <exec_depend>velodyne_driver</exec_depend>
  <exec_depend>velodyne_pointcloud</exec_depend>

  <!-- 테스트는 CMakeLists의 catkin_add_nosetests로 실행 -->
  <test_depend>python3-nose</test_depend>

  <export>
  </export>
</package>
