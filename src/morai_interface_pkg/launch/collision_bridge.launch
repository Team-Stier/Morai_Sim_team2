<launch>
  <arg name="enable" default="false"/>
  <arg name="config" default="$(find morai_interface_pkg)/config/collision_bridge.yaml"/>

  <node pkg="morai_interface_pkg" type="collision_receiver_node"
        name="morai_collision_bridge" output="screen" required="true"
        if="$(arg enable)">
    <rosparam command="load" file="$(arg config)"/>
  </node>
</launch>
