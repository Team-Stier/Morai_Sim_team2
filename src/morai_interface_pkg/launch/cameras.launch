<launch>
  <!-- 여러 카메라(Front/Left/Right)를 한 번에 실행한다.
       각 노드는 같은 camera_receiver_node를 다른 name/port/topic으로 띄운 인스턴스.
       포트/카메라 이름은 현재 Simulator 센서 설정과 맞춰 검증했다. -->

  <arg name="front_config" default="$(find morai_interface_pkg)/config/camera_front.yaml"/>
  <arg name="left_config"  default="$(find morai_interface_pkg)/config/camera_left.yaml"/>
  <arg name="right_config" default="$(find morai_interface_pkg)/config/camera_right.yaml"/>

  <node pkg="morai_interface_pkg" type="camera_receiver_node"
        name="morai_camera_front" output="screen" required="true">
    <rosparam command="load" file="$(arg front_config)"/>
  </node>

  <node pkg="morai_interface_pkg" type="camera_receiver_node"
        name="morai_camera_left" output="screen" required="true">
    <rosparam command="load" file="$(arg left_config)"/>
  </node>

  <node pkg="morai_interface_pkg" type="camera_receiver_node"
        name="morai_camera_right" output="screen" required="true">
    <rosparam command="load" file="$(arg right_config)"/>
  </node>
</launch>
